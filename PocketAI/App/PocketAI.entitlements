<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group for shared data between app and extensions -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.pocketai.shared</string>
    </array>
    <!-- Critical: allows the app to use more than the default memory limit -->
    <!-- Required for loading large ML models (>1 GB) -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    <!-- Extended virtual addressing for very large models on supported devices -->
    <key>com.apple.developer.kernel.extended-virtual-addressing</key>
    <true/>
</dict>
</plist>
